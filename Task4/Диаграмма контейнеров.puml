@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
' uncomment the following line and comment the first to use locally
' !include C4_Context.puml

title Диаграмма контейнеров

Person(Пользователь, "Пользователь")
System(Сайт, "Сайт")
System(Сервис_переадресации, "Сервис_переадресации")
System(Колл_центр_банка, "Колл_центр_банка")
System_Ext(Партнерский_колл_центр, "Партнерский_колл_центр")
System(Автоматический_помощник_колл_центра, "Автоматический_помощник_колл_центра")
System(АБС, "АБС")
System(Api_gateway, "Api_gateway")
System(База_данных, "База данных")


Rel(Пользователь, Сервис_переадресации, "звонок")
Rel(Сервис_переадресации, Колл_центр_банка, "звонок")
Rel(Сервис_переадресации, Партнерский_колл_центр, "звонок")
Rel(Сервис_переадресации, Автоматический_помощник_колл_центра, "звонок")

Rel(Колл_центр_банка, Сайт, "Получение актуальных ставок")
Rel(Сайт, Api_gateway, "Api call")
Rel(Api_gateway, АБС, "Получение актуальных ставок")
Rel(Партнерский_колл_центр, Сайт, "Получение актуальных ставок")
Rel(Автоматический_помощник_колл_центра, АБС, "Получение актуальных ставок")




Rel_Neighbor(АБС, Api_gateway, "получение актуальных ставок")
Rel_Neighbor(Api_gateway, Сайт, "получение актуальных ставок")

Rel(АБС, База_данных, "обмен данными")

@enduml